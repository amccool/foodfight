<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- console exe so - -selftest output is visible; the game window opens alongside -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>FoodFight</AssemblyName>
    <RootNamespace>FoodFight</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- the Core sources compile directly into each head; the UWP/Xbox
         project includes the same files, so Core needs no csproj of its own -->
    <Compile Include="..\FoodFight.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

</Project>
